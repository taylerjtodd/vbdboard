{
  "manifest_version": 3,
  "name": "Sleeper VBD Draft Assistant",
  "version": "1.0.0",
  "description": "Real-time Value-Based Drafting (VBD) overlay and pick tracker for Sleeper fantasy football drafts.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.sleeper.app/*",
    "https://sleeper.com/*",
    "https://*.sleeper.com/*",
    "https://sleeper.app/*",
    "https://*.sleeper.app/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Sleeper VBD Assistant",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sleeper.com/draft/*",
        "https://*.sleeper.com/draft/*",
        "https://sleeper.app/draft/*",
        "https://*.sleeper.app/draft/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/players.json",
        "lib/*",
        "icons/*"
      ],
      "matches": [
        "https://sleeper.com/*",
        "https://*.sleeper.com/*",
        "https://sleeper.app/*",
        "https://*.sleeper.app/*"
      ]
    }
  ]
}
